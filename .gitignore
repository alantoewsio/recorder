/target
**/*.rs.bk

# Local secrets and env
.env
.env.*
!.env.example

# Logs and local artifacts
*.log
dist/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python

# Cargo vendored crates (regenerate with `cargo vendor` if needed)
vendor/

# Local bundled CMake tree (use system CMake or download kit)
tools/cmake-*/
tools/cmake-*.zip
